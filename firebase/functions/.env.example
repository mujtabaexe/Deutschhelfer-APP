# Template for deployed function settings. Copy to .env.<project-id> (for
# example .env.deutschhelfer-prod), which is git-ignored, and fill in. None of
# these values are secrets; the Play service account is NOT configured here
# (functions use their runtime service account, granted access in Play Console).

# Keep true in every real project. Only the emulator turns it off.
ENFORCE_APP_CHECK=true

# Android package name, once subscriptions exist (open question Q1).
PLAY_PACKAGE_NAME=

# JSON map of Play product ids to tiers, e.g. {"premium_monthly":"premium"}.
PRODUCT_TIERS={}

# Push needs FCM, which works on any plan, but the triggers that send it are
# Cloud Functions, which need Blaze.
PUSH_ENABLED=true
