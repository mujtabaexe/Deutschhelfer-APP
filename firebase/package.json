{
  "name": "deutschhelfer-firebase",
  "private": true,
  "description": "Firestore rules, indexes and emulator tests for Deutschhelfer.",
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-deutschhelfer",
    "test": "firebase emulators:exec --only firestore --project demo-deutschhelfer \"node --test --test-concurrency=1 test/rules.test.mjs\"",
    "test:functions": "cd functions && npm test",
    "check:hosting": "node scripts/check-hosting.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  }
}
