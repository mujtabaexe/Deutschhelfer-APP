<?xml version="1.0" encoding="utf-8"?>
<!--
  Excludes all app data from cloud backup and device-to-device transfer on
  Android 12 and later. Signed-in sessions and cached messages must not be
  restored onto another device. allowBackup="false" in the manifest covers
  older Android versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
