rules_version = '2';

// Deutschhelfer Firestore Security Rules.
//
// Principles:
// - Deny by default. Anything not matched below is denied.
// - Roles ('owner', 'student-admin') and premium status come only from Auth
//   custom claims, which only trusted backend code can set.
// - Every client write is checked for exact keys, types, lengths, ownership
//   and server timestamps.
// - Cloud Functions use the Admin SDK and bypass these rules; they must
//   authorize callers themselves.
//
// Tests: firebase/test/rules.test.mjs (run with `npm test` in firebase/).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identity ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    function claimRole() {
      return request.auth.token.get('role', 'student');
    }

    // Staff powers lapse while the staff account itself is suspended.
    function isOwner() {
      return signedIn() && claimRole() == 'owner' && !isRestricted();
    }

    // The claim alone is not enough: an ID token issued before a demotion
    // stays valid for up to an hour. The server-written staff marker is
    // removed at demotion, so it is checked too.
    function isStudentAdmin() {
      return signedIn() && claimRole() == 'student-admin' && !isRestricted()
        && staffRole(uid()) == 'student-admin';
    }

    // Server-written marker for staff accounts, kept in step with the role
    // claim by functions. Lets the rules protect staff from each other.
    function staffRole(userId) {
      return exists(/databases/$(database)/documents/staff/$(userId))
        ? get(/databases/$(database)/documents/staff/$(userId)).data.role
        : 'none';
    }

    function isStaff() {
      return isOwner() || isStudentAdmin();
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isRestricted() {
      return exists(/databases/$(database)/documents/accountRestrictions/$(uid()));
    }

    // Verified, and not suspended or deleted.
    function canPost() {
      return verified() && !isRestricted();
    }

    function isPremium() {
      return verified() && request.auth.token.get('premium', false) == true;
    }

    // ---------- Validation ----------

    // Must match lib/domain/validation/link_detector.dart.
    function hasLink(text) {
      return text.matches('(?is).*(https?://|www[.．。｡]|[a-z0-9-]+[.．。｡][a-z][a-z]+([^a-z0-9]|$)).*');
    }

    function textValid(text, maxLength) {
      return text is string
        && text.size() <= maxLength
        && text.trim().size() > 0;
    }

    function nameValid(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 40
        && name == name.trim()
        && !name.matches('.*[<>].*')
        && !hasLink(name);
    }

    function exactKeys(keys) {
      return request.resource.data.keys().hasOnly(keys)
        && request.resource.data.keys().hasAll(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // One post per second per user, enforced with a rateLimits document
    // written in the same batch. The document names the one message it
    // covers, so a batch cannot carry several messages.
    function rateLimitOk(messageId) {
      return getAfter(/databases/$(database)/documents/rateLimits/$(uid())).data.lastPostAt == request.time
        && getAfter(/databases/$(database)/documents/rateLimits/$(uid())).data.lastMessageId == messageId;
    }

    function rateLimitTouched() {
      return getAfter(/databases/$(database)/documents/rateLimits/$(uid())).data.lastPostAt == request.time;
    }

    function profileName(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.displayName;
    }

    // ---------- Community rules acceptance ----------

    // Must match currentRulesVersion in lib/domain/models/legal.dart.
    // Google Play requires users to accept the rules before posting.
    function minRulesVersion() {
      return 1;
    }

    // Reads the same profile document as profileName(), which rules
    // evaluation bills once per request.
    function acceptedRules(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data
        .get('rulesVersion', 0) >= minRulesVersion();
    }

    // Acceptance fields are optional on a profile, but always come together,
    // and the time is the server's. Only the current version can be
    // accepted, so nobody can pre-accept future rules and skip re-consent.
    function rulesFieldsValid(data) {
      return (!('rulesVersion' in data) && !('rulesAcceptedAt' in data))
        || (data.rulesVersion == minRulesVersion()
            && data.rulesAcceptedAt == request.time);
    }

    // Unchanged, or a newer version accepted now.
    function rulesChangeValid() {
      return (request.resource.data.get('rulesVersion', 0) == resource.data.get('rulesVersion', 0)
          && request.resource.data.get('rulesAcceptedAt', null) == resource.data.get('rulesAcceptedAt', null))
        || (rulesFieldsValid(request.resource.data)
            && 'rulesVersion' in request.resource.data
            && request.resource.data.rulesVersion > resource.data.get('rulesVersion', 0));
    }

    // ---------- Groups helpers ----------

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(userId);
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, uid()));
    }

    // Group moderators are student-admins with the moderator role in that
    // group. The owner moderates every group.
    function isGroupModerator(groupId) {
      return isOwner()
        || (isStudentAdmin()
            && exists(memberPath(groupId, uid()))
            && get(memberPath(groupId, uid())).data.role == 'moderator');
    }

    // Must match InputValidators.groupName and groupDescription.
    function groupFieldsValid(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 60
        && data.name == data.name.trim()
        && !data.name.matches('.*[<>].*')
        && !hasLink(data.name)
        && data.description is string && data.description.size() <= 500
        && data.category in ['admissions', 'visa', 'ielts', 'living', 'general']
        && data.isActive is bool;
    }

    // ---------- Conversations helpers ----------

    function convPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function hasBlocked(blocker, blocked) {
      return exists(/databases/$(database)/documents/users/$(blocker)/blocked/$(blocked));
    }

    // ---------- Users ----------

    match /users/{userId} {
      // Public profile: display name only. Emails are never stored here.
      // Single reads only, so the user directory cannot be scraped.
      allow get: if signedIn();
      allow list: if false;

      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll(['displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt',
                                                 'rulesVersion', 'rulesAcceptedAt'])
        && nameValid(request.resource.data.displayName)
        && rulesFieldsValid(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // One rename an hour (each fans out to memberships), except replacing
      // the sign-up fallback name. Accepting the rules is always allowed.
      allow update: if isSelf(userId)
        && !isRestricted()
        && (request.resource.data.displayName == resource.data.displayName
            || request.time > resource.data.updatedAt + duration.value(1, 'h')
            || (resource.data.displayName == 'Student'
                && resource.data.updatedAt == resource.data.createdAt))
        && changedOnly(['displayName', 'updatedAt', 'rulesVersion', 'rulesAcceptedAt'])
        && nameValid(request.resource.data.displayName)
        && rulesChangeValid()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /blocked/{otherId} {
        allow read, delete: if isSelf(userId);
        allow create: if isSelf(userId)
          && !isRestricted()
          && otherId != userId
          && exactKeys(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      // Push devices. The FCM token is the document id. Only the user adds
      // or removes their own; Cloud Functions read at most ten per user, so
      // extra documents cannot multiply sending cost.
      match /devices/{token} {
        allow read, delete: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && canPost()
          && token.matches('^[A-Za-z0-9_:-]{20,512}$')
          && exactKeys(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---------- Account restrictions ----------

    match /accountRestrictions/{userId} {
      allow read: if isSelf(userId) || isStaff();

      // Staff may suspend others, never themselves. 'deleted' is set only by
      // the backend account-deletion function and cannot be overwritten.
      // Lifting a suspension goes through the liftSuspension function so the
      // audit log records who did it.
      // Student-admins cannot suspend staff. Nobody can suspend the owner.
      allow create, update: if isStaff()
        && (resource == null || resource.data.status == 'suspended')
        && userId != uid()
        && staffRole(userId) != 'owner'
        && (isOwner() || staffRole(userId) == 'none')
        && exactKeys(['status', 'reason', 'updatedBy', 'updatedAt'])
        && request.resource.data.status == 'suspended'
        && textValid(request.resource.data.reason, 500)
        && request.resource.data.updatedBy == uid()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Rate limits ----------

    match /rateLimits/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && !isRestricted()
        && exactKeys(['lastPostAt', 'lastMessageId'])
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastPostAt == request.time;
      allow update: if isSelf(userId)
        && !isRestricted()
        && exactKeys(['lastPostAt', 'lastMessageId'])
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastPostAt == request.time
        && request.time > resource.data.lastPostAt + duration.value(1, 's');
      allow delete: if false;
    }

    // ---------- Groups ----------

    match /groups/{groupId} {
      // Names and descriptions are visible to any signed-in user, including
      // unverified ones (open question Q5).
      allow read: if signedIn();

      // "new" is reserved by the app's /groups/new route.
      allow create: if isOwner()
        && groupId != 'new'
        && exactKeys(['name', 'description', 'category', 'createdBy',
                      'createdAt', 'isActive', 'memberCount'])
        && groupFieldsValid(request.resource.data)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.isActive == true
        && request.resource.data.memberCount == 0;

      // memberCount is maintained by a Cloud Function only.
      allow update: if isOwner()
        && changedOnly(['name', 'description', 'category', 'isActive'])
        && groupFieldsValid(request.resource.data);

      allow delete: if false;

      match /members/{memberId} {
        // Member lists are visible to members of that group only.
        allow get: if isSelf(memberId) || isMember(groupId) || isOwner();
        allow list: if isMember(groupId) || isOwner();

        allow create: if exactKeys(['uid', 'role', 'displayName', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.joinedAt == request.time
          && request.resource.data.displayName == profileName(memberId)
          && (
            (isSelf(memberId)
              && canPost()
              && acceptedRules(memberId)
              && request.resource.data.role == 'member'
              && get(groupPath(groupId)).data.isActive == true
              && get(groupPath(groupId)).data.memberCount < 2000)
            || (isOwner()
              && acceptedRules(memberId)
              && request.resource.data.role in ['member', 'moderator'])
          );

        allow update: if isOwner()
          && changedOnly(['role'])
          && request.resource.data.role in ['member', 'moderator'];

        // Leave, or removal by the owner, or removal of an ordinary member by
        // a group moderator.
        allow delete: if isSelf(memberId)
          || isOwner()
          || (isGroupModerator(groupId) && resource.data.role == 'member');
      }

      match /messages/{messageId} {
        // Members see visible messages and their own pending ones.
        // Queries must filter on status == 'visible' or senderId == uid.
        allow read: if (isMember(groupId)
            && (resource.data.status == 'visible'
                || resource.data.senderId == uid()))
          || isGroupModerator(groupId);

        allow create: if canPost()
          && isMember(groupId)
          && acceptedRules(uid())
          && get(groupPath(groupId)).data.isActive == true
          && exactKeys(['senderId', 'senderName', 'text', 'createdAt', 'status'])
          && request.resource.data.senderId == uid()
          && request.resource.data.senderName == profileName(uid())
          && textValid(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time
          && (
            (hasLink(request.resource.data.text)
              && request.resource.data.status == 'pending')
            || (!hasLink(request.resource.data.text)
              && request.resource.data.status == 'visible')
          )
          && rateLimitOk(messageId);

        allow update: if (
            // Moderation: approve or remove, never on your own message.
            isGroupModerator(groupId)
            && resource.data.senderId != uid()
            && changedOnly(['status', 'moderatedBy', 'moderatedAt'])
            && request.resource.data.moderatedBy == uid()
            && request.resource.data.moderatedAt == request.time
            && (
              (resource.data.status == 'pending'
                && request.resource.data.status in ['visible', 'removed'])
              || (resource.data.status == 'visible'
                && request.resource.data.status == 'removed')
            )
          ) || (
            // The sender may withdraw their own message.
            isSelf(resource.data.senderId)
            && changedOnly(['status'])
            && resource.data.status in ['visible', 'pending']
            && request.resource.data.status == 'withdrawn'
          );

        allow delete: if false;
      }
    }

    // "My groups": a collection-group query over memberships, limited to the
    // caller's own membership documents.
    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.uid == uid();
    }

    // The owner's cross-group moderation queue. Direct messages live in a
    // differently named subcollection, so this never exposes them.
    match /{path=**}/messages/{messageId} {
      allow read: if isOwner();
    }

    // ---------- Direct messages ----------

    match /conversations/{conversationId} {
      // A user may check whether their own conversation exists yet, but learns
      // nothing about conversations between other people.
      allow get: if signedIn()
        && (resource == null
              ? uid() in conversationId.split('_')
              : uid() in resource.data.participants);
      allow list: if signedIn() && uid() in resource.data.participants;

      // Only between two members of the same group, neither blocking the
      // other (open question Q2 default).
      allow create: if canPost()
        && exactKeys(['participants', 'groupId', 'createdAt', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && uid() in request.resource.data.participants
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && acceptedRules(request.resource.data.participants[0])
        && acceptedRules(request.resource.data.participants[1])
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.resource.data.groupId is string
        && exists(memberPath(request.resource.data.groupId, request.resource.data.participants[0]))
        && exists(memberPath(request.resource.data.groupId, request.resource.data.participants[1]))
        && !hasBlocked(request.resource.data.participants[0], request.resource.data.participants[1])
        && !hasBlocked(request.resource.data.participants[1], request.resource.data.participants[0])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Summary updates ride with a rate-limited message and respect blocks,
      // so a blocked user cannot push text into the other inbox.
      allow update: if canPost()
        && acceptedRules(uid())
        && uid() in resource.data.participants
        && !hasBlocked(resource.data.participants[0], uid())
        && !hasBlocked(resource.data.participants[1], uid())
        && rateLimitTouched()
        && changedOnly(['updatedAt', 'lastMessage'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage.keys().hasOnly(['senderId', 'text'])
        && request.resource.data.lastMessage.senderId == uid()
        && textValid(request.resource.data.lastMessage.text, 120);

      allow delete: if false;

      match /directMessages/{messageId} {
        allow read: if signedIn()
          && uid() in get(convPath(conversationId)).data.participants;

        allow create: if canPost()
          && acceptedRules(uid())
          && uid() in get(convPath(conversationId)).data.participants
          && exactKeys(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == uid()
          && textValid(request.resource.data.text, 2000)
          && request.resource.data.createdAt == request.time
          && !hasBlocked(get(convPath(conversationId)).data.participants[0], uid())
          && !hasBlocked(get(convPath(conversationId)).data.participants[1], uid())
          && !hasBlocked(uid(), get(convPath(conversationId)).data.participants[0])
          && !hasBlocked(uid(), get(convPath(conversationId)).data.participants[1])
          && rateLimitOk(messageId);

        allow update, delete: if false;
      }
    }

    // ---------- Reports ----------

    function reportTargetValid(data) {
      return (
          data.targetType == 'groupMessage'
          && data.groupId is string
          && data.conversationId == null
          && isMember(data.groupId)
          && get(/databases/$(database)/documents/groups/$(data.groupId)/messages/$(data.targetId)).data.status == 'visible'
          && get(/databases/$(database)/documents/groups/$(data.groupId)/messages/$(data.targetId)).data.senderId == data.targetUserId
          && get(/databases/$(database)/documents/groups/$(data.groupId)/messages/$(data.targetId)).data.text == data.excerpt
        ) || (
          data.targetType == 'directMessage'
          && data.conversationId is string
          && data.groupId == null
          && uid() in get(convPath(data.conversationId)).data.participants
          && get(/databases/$(database)/documents/conversations/$(data.conversationId)/directMessages/$(data.targetId)).data.senderId == data.targetUserId
          && get(/databases/$(database)/documents/conversations/$(data.conversationId)/directMessages/$(data.targetId)).data.text == data.excerpt
        ) || (
          data.targetType == 'user'
          && data.targetId == data.targetUserId
          && data.groupId == null
          && data.conversationId == null
          && data.excerpt == ''
          && exists(/databases/$(database)/documents/users/$(data.targetId))
          && exists(/databases/$(database)/documents/users/$(data.targetId))
        );
    }

    match /reports/{reportId} {
      allow read: if isStaff();

      // One report per reporter and target: the id is deterministic, and
      // existing reports cannot be overwritten.
      allow create: if canPost()
        && exactKeys(['reporterId', 'targetType', 'targetId', 'targetUserId',
                      'groupId', 'conversationId', 'reason', 'details',
                      'excerpt', 'createdAt', 'status'])
        && request.resource.data.reporterId == uid()
        && reportId == uid() + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.targetId is string
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != uid()
        && request.resource.data.reason in ['spam', 'harassment', 'scam', 'inappropriate', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.excerpt is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && reportTargetValid(request.resource.data);

      allow update: if isStaff()
        && changedOnly(['status', 'resolvedBy', 'resolvedAt', 'resolution'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['dismissed', 'actioned']
        && request.resource.data.resolvedBy == uid()
        && request.resource.data.resolvedAt == request.time
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() <= 500;

      allow delete: if false;
    }

    // ---------- Premium and billing ----------

    match /premiumContent/{articleId} {
      allow read: if isPremium();
      allow write: if false;
    }

    // Written only by the purchase-verification function.
    match /subscriptions/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // ---------- Staff markers ----------

    // Written only by functions and the owner bootstrap script.
    match /staff/{userId} {
      allow read, write: if false;
    }

    // ---------- Audit ----------

    // Append-only, written by Cloud Functions.
    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
